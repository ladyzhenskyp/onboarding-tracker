# Copy to .env and fill in. `.env` is git-ignored.

# Local dev uses SQLite (file in repo root). Render/Railway will inject a
# postgresql:// URL here in production.
DATABASE_URL=sqlite:///./tracker.db

# Used to sign the session cookie for the demo login. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Demo login credentials (Phase 4)
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234

# Path to the risk-rule thresholds (see docs/risk-rules.md)
RISK_RULES_PATH=./app/risk_rules.yaml
